{
  "_comment_1": "Merge the `hooks` block into your ~/.claude/settings.json (do NOT overwrite the whole file).",
  "_comment_2": "Replace <PLUGIN_PATH> below with the absolute path to this plugin's install directory. Typical locations:",
  "_comment_3": "  ~/.claude/plugins/cache/<marketplace>/plugins/rlm-auto",
  "_comment_4": "  <your-checkout>/claude/plugins/billys-rlm-auto",
  "_comment_5": "${CLAUDE_PLUGIN_ROOT} only expands inside SKILL-invoked commands, not user-level settings.json. Use absolute paths here.",
  "_comment_6": "On Linux/macOS swap `py -3` for `python3`.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"<PLUGIN_PATH>/hooks/user_prompt_submit.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Glob|Grep|WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"<PLUGIN_PATH>/hooks/post_tool_use.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"<PLUGIN_PATH>/hooks/post_tool_use.py\" --on-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
